{
  "name": "eonarys",
  "version": "0.1.0",
  "private": true,
  "description": "EONARYS — Tu vida. En contexto.",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @eonarys/web dev",
    "build": "pnpm --filter @eonarys/web build",
    "start": "pnpm --filter @eonarys/web start",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "vite": "^6.4.3"
    }
  }
}

# EONARYS — example environment variables
# Copy to .env.local (never commit real values).
# 0.1 Foundation does not call any external service; these are placeholders
# for the local Postgres dev environment only (see docs/ARCHITECTURE.md).

# App
NEXT_PUBLIC_APP_NAME=EONARYS
NODE_ENV=development

# Database (docker-compose.yml dev Postgres — see DATA_MODEL.md)
DATABASE_URL=postgresql://eonarys:eonarys@localhost:5432/eonarys_dev

# Reserved for future phases (0.2+) — do not implement yet, see docs/ROADMAP.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AI_PROVIDER_API_KEY=
